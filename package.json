{
  "name": "eventbridge",
  "version": "1.0.0",
  "private": true,
  "description": "EventBridge: Multi-College Event Management Platform",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:backend:java": "java -cp \"backend-java/bin;backend-java/*\" com.eventbridge.server.EventBridgeServer",
    "dev:backend:node": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
