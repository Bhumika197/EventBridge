{
  "name": "eventbridge",
  "version": "1.0.0",
  "private": true,
  "description": "EventBridge: Multi-College Event Management Platform",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "java -cp \"backend-java/bin;backend-java/*\" com.eventbridge.server.EventBridgeServer",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:backend": "node -e \"console.log('Java backend ready in backend-java/bin')\"",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
