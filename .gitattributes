# GitHub Linguist Language Configuration

# Exclude any TypeScript from detection
*.ts linguist-detectable=false
*.tsx linguist-detectable=false
*.ts linguist-vendored
*.tsx linguist-vendored

# Java is the primary language of the codebase
backend-java/** linguist-detectable=true
*.java linguist-detectable=true

# Web frontend files
frontend/src/** linguist-detectable=true
*.jsx linguist-detectable=true
*.js linguist-detectable=true
*.css linguist-detectable=true
*.html linguist-detectable=true

# Vendor / Build Artifacts
backend-java/bin/** linguist-vendored
backend-java/*.jar linguist-vendored
frontend/dist/** linguist-vendored
backend/data/** linguist-vendored
*.jar linguist-vendored
*.db linguist-vendored
package-lock.json linguist-vendored
